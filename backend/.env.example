# Copy this file to .env and fill in your values.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL connection string. Create the database first:
#   psql -U postgres -c "CREATE DATABASE agentic_qa;"
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentic_qa

# Optional overrides
QA_MODEL=claude-opus-4-8
QA_EFFORT=high
# Set to false to watch the browser run (non-headless)
QA_HEADLESS=true
