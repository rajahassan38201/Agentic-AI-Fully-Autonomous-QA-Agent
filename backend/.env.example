# Copy this file to .env and fill in your values.

# Your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Key used to encrypt project login credentials at rest. Any passphrase works.
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it stable: changing it makes saved credentials unreadable, and they have
# to be re-entered on each project.
APP_SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection string. Create the database first:
#   psql -U postgres -c "CREATE DATABASE agentic_qa;"
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agentic_qa

# Optional overrides
QA_MODEL=claude-opus-4-8
QA_EFFORT=high
# Set to false to watch the browser run (non-headless)
QA_HEADLESS=true
